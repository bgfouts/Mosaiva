OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_REASONING_MODEL=gpt-5.6-terra
MOSAIVA_SEED_HYPOTHESES=1
MOSAIVA_SEED_INTERVENTIONS=1
MOSAIVA_SEED_RESEARCH=1

# Leave empty to use data/mosaiva.db. On Vercel the Neon integration sets DATABASE_URL.
MOSAIVA_DATABASE_URL=

# Google sign-in. Always on when deployed; on locally once GOOGLE_CLIENT_ID is set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated. Only these Google accounts can open the record.
MOSAIVA_ALLOWED_EMAILS=
# At least 32 random characters, e.g. `openssl rand -base64 48`.
MOSAIVA_SESSION_SECRET=
# Optional. Fixes the OAuth redirect to one domain, e.g. https://mosaiva.vercel.app
MOSAIVA_PUBLIC_URL=

# Vercel Blob for saved PDFs. Connecting a Blob store on Vercel sets these for you.
BLOB_READ_WRITE_TOKEN=
